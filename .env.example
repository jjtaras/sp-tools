# Per-machine settings. Copy to .env and fill in; .env is gitignored.

# Local path to SP's sp-tools-config folder (via Google Drive for desktop).
# Mac example:  ~/Library/CloudStorage/GoogleDrive-<sp account>/Shared drives/sp-tools-config
# PC example:   G:\Shared drives\sp-tools-config
SP_CONFIG_DIR=

# Innergy API key (only needed for local adapter work; the deployed apps use Script Properties)
INNERGY_API_KEY=
